# Port on which your application is running
PORT=8000

# JWT Secret for authentication (Make sure to set a strong secret key here)
JWT_SECRET="yourSuperSecretKey"

# Database URL (Connection string for your database, typically in this format: postgres://user:password@host:port/dbname)
database_url="postgres://username:password@hostname:port/database"

# Neon credentials (ensure these are set for your PostgreSQL database)
PGHOST='your_database_host'
PGDATABASE='your_database_name'
PGUSER='your_database_user'
PGPASSWORD='your_database_password'
ENDPOINT_ID='your_neon_endpoint_id'

# Client and Server URLs (for API and Frontend communication)
CLIENT_URL='http://your-client-url.com'
SERVER_URL='http://your-server-url.com'
SERVER_URL_2='http://your-secondary-server-url.com'

# Local development URLs
LOCAL_URL='http://localhost:3000'  # Default for Next.js
LOCAL_URL2='http://localhost:8000' # Default for your NestJS server

# Next.js Auth secret for handling authentication (set this to a strong, secret key)
NEXT_PUBLIC_NEXTAUTH_SECRET='your_nextauth_secret_key'

# JWT secret for Next.js (Make sure this matches your backend JWT secret)
NEXT_PUBLIC_JWT_SECRET='yourSuperSecretKey'

# Public server URL for use in the frontend (ensure this points to your actual server endpoint)
NEXT_PUBLIC_SERVER_URL='http://your-public-server-url.com'
